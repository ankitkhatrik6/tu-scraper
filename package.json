{
  "name": "tu-scraper",
  "version": "1.0.0",
  "description": "Production-ready TypeScript scraper and npm package to fetch official Tribhuvan University (TU) notices across all 8 verified institute and faculty portals.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "next dev",
    "build:site": "next build",
    "build:lib": "tsup src/index.ts --format cjs,esm --dts --tsconfig tsconfig.lib.json",
    "build": "npm run build:lib && npm run build:site",
    "start": "next start",
    "lint": "eslint .",
    "test": "tsx tests/runner.ts",
    "clean": "next clean"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.1",
    "autoprefixer": "^10.4.21",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "^15.4.9",
    "postcss": "^8.5.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "4.1.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.8",
    "firebase-tools": "^15.0.0",
    "tailwindcss": "4.1.11",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  },
  "author": "Ankit Khatri KC",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankitkhatrik6/tu-scraper.git"
  },
  "keywords": [
    "tu",
    "tribhuvan-university",
    "scraper",
    "notices",
    "nepal"
  ]
}
